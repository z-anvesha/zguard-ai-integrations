<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  ZSCALER-AIGUARD — unified AI Guard scan flow.

  Called from a proxy's request flow (type=user-prompt) and/or response flow
  (type=response-prompt | both). The same steps run in either leg; the phase and
  the parsed message decide what is scanned and in which direction. Steps after
  detection are gated so the flow is a clean no-op when there is nothing to scan.

  One invocation scans one direction: prompt -> IN, response -> OUT.
-->
<SharedFlow name="default">

  <!-- 1. Config: API key (and optional pinned policy id) from KVM, then
          normalise every knob into the aiguard.cfg.* namespace. -->
  <Step><Name>KVM-GetAIGuardConfig</Name></Step>
  <Step><Name>JS-InitConfig</Name></Step>

  <!-- 2. Fail-closed guard: no API key configured. -->
  <Step>
    <Name>RF-ConfigError</Name>
    <Condition>aiguard.cfg.keyMissing = "true" and aiguard.cfg.failOpen = "false"</Condition>
  </Step>

  <!-- 3. Detect API dialect, whether to scan, and the identifiers. -->
  <Step><Name>JS-DetectContext</Name></Step>

  <!-- 4. Extract content (multi-format plus inline tool calls). -->
  <Step>
    <Name>JS-ExtractContent</Name>
    <Condition>aiguard.shouldScan = "true"</Condition>
  </Step>

  <!-- 5. Build body -> call the API -> parse verdict -> decide outcome.
          Gated on hasContent so a text-less turn never sends an empty scan. -->
  <Step>
    <Name>JS-BuildAIGuardScanBody</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true"</Condition>
  </Step>
  <Step>
    <Name>AM-SetAIGuardScanRequest</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0"</Condition>
  </Step>

  <!-- With no policy id the API resolves the policy bound to the key; a pinned
       id takes the execute-policy path instead. Exactly one of these runs. -->
  <Step>
    <Name>SC-AIGuardScan</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0" and aiguard.cfg.policyId = ""</Condition>
  </Step>
  <Step>
    <Name>SC-AIGuardExecutePolicy</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0" and aiguard.cfg.policyId != ""</Condition>
  </Step>

  <Step>
    <Name>EV-ParseAIGuardVerdict</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0"</Condition>
  </Step>
  <Step>
    <Name>JS-ParseDetectors</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0"</Condition>
  </Step>
  <Step>
    <Name>JS-ProcessVerdict</Name>
    <Condition>aiguard.shouldScan = "true" and aiguard.hasContent = "true" and aiguard.contentCount != "0"</Condition>
  </Step>

  <!-- 6. Act on the verdict. AI Guard returns a verdict rather than a rewritten
          payload, so there is no masking step: the outcome is allow or block. -->
  <Step>
    <Name>RF-Block</Name>
    <Condition>aiguard.outcome = "block"</Condition>
  </Step>

</SharedFlow>
