# Cloud Build substitution values for the AI Guard on Apigee provisioning
# pipeline. setup/bootstrap.py writes these onto the trigger; this file
# documents them.

# --- required -------------------------------------------------------------
_REGION=us-central1
_APIGEE_ENV=eval
# Vertex caller service account. Created by the pipeline if it does not exist.
_VERTEX_SA=aiguard-vertex@YOUR_PROJECT_ID.iam.gserviceaccount.com
# Service account the Cloud Run Job runs as (bootstrap.py creates it).
_RUNTIME_SA=aiguard-provisioner@YOUR_PROJECT_ID.iam.gserviceaccount.com

# --- optional -------------------------------------------------------------
# Apigee org; empty means the script uses PROJECT_ID.
_APIGEE_ORG=
# Environment-group hostname. When set, the run prints a ready-to-paste
# smoke-test curl at the end.
_ENVGROUP_HOSTNAME=
# Pin one AI Guard policy id. LEAVE EMPTY unless you have a specific reason:
# empty means the API resolves the policy bound to your key, and an id that does
# not exist for the key comes back as "Policy not found" inside an HTTP 200.
_AIGUARD_POLICY_ID=
# AI Guard cloud region and the Vertex model the proxy targets. Both are
# written into the KVM; the proxy templates its target URL from the model.
_AIGUARD_CLOUD=us1
_VERTEX_MODEL=gemini-2.5-flash
# Artifact Registry repo and Cloud Run Job names.
_AR_REPO=aiguard-apigee
_JOB_NAME=aiguard-apigee-proxy-provisioner

# --- secret ---------------------------------------------------------------
# The AI Guard API key is NOT set here. bootstrap.py stores it in Secret
# Manager as `aiguard-api-key`, and cloudbuild.yaml injects it into the Job.
