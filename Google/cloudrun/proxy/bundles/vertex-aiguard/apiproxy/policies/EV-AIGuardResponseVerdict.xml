<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables name="EV-AIGuardResponseVerdict">
  <Source>aiguardRespscanResult</Source>
  <JSONPayload>
    <Variable name="aiguard.scan.response.action" type="string">
      <JSONPath>$.action</JSONPath>
    </Variable>
    <Variable name="aiguard.scan.response.severity" type="string">
      <JSONPath>$.severity</JSONPath>
    </Variable>
    <Variable name="aiguard.scan.response.transaction.id" type="string">
      <JSONPath>$.transactionId</JSONPath>
    </Variable>
    <Variable name="aiguard.scan.response.policy.name" type="string">
      <JSONPath>$.policyName</JSONPath>
    </Variable>
    <!-- See EV-AIGuardVerdict: a 200 can carry an in-body failure status. -->
    <Variable name="aiguard.scan.response.body.status" type="string">
      <JSONPath>$.statusCode</JSONPath>
    </Variable>
    <Variable name="aiguard.scan.response.error.msg" type="string">
      <JSONPath>$.errorMsg</JSONPath>
    </Variable>
  </JSONPayload>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
