# Copy to .env for local runs (optional). Jenkins uses credentials + parameters.
# .env is gitignored.

# Zscaler AI Guard (required for scan_policy.py)
AIGUARD_API_KEY=
AIGUARD_CLOUD=us1
# Optional — numeric ID; if unset, uses resolve-and-execute-policy
# Optional and rarely needed. Leave unset: the API then resolves the policy
# bound to your API key. Setting a policy id switches to /detection/execute-policy,
# and an id that does not exist for your key returns "Policy not found".
# AIGUARD_POLICY_ID=
AIGUARD_TIMEOUT=30

# Google Cloud (Vertex AI deploy / test — optional for scan-only jobs)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
# Local: path to service account JSON; Jenkins uses gcp-sa-key credential file
GOOGLE_APPLICATION_CREDENTIALS=

HF_TOKEN=
