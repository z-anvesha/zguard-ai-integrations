# Zscaler AI Guard credentials -- AI Guard Console > Private AI Apps > App API Keys
AIGUARD_API_KEY=your-aiguard-api-key-here

# Optional: cloud region (default: us1) -- us1, us2, eu1, eu2
# AIGUARD_CLOUD=us1

# Optional: request timeout in seconds (default: 30)
# AIGUARD_TIMEOUT=30

# Optional: pin one policy id. Leave unset -- the API then resolves the policy
# bound to your API key. A stale id silently pins scanning to the wrong policy.
# AIGUARD_POLICY_ID=1152

# Optional: full base URL, overrides AIGUARD_CLOUD
# AIGUARD_OVERRIDE_URL=https://api.us1.zseclipse.net

# Optional: model used by the example handlers
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
