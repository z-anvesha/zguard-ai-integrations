# Zscaler AI Guard — copy to Windsurf/.env (or use repository root .env)
AIGUARD_API_KEY=
AIGUARD_CLOUD=us1
# Optional numeric policy ID
# Optional and rarely needed. Leave unset: the API then resolves the policy
# bound to your API key. Setting a policy id switches to /detection/execute-policy,
# and an id that does not exist for your key returns "Policy not found".
# AIGUARD_POLICY_ID=
AIGUARD_TIMEOUT=30
